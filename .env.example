# ─── TypeSafe Jev ──────────────────────────────────────────────────────────────
# Required: API key for the TypeSafe Jev model (https://typesafe.ai)
TYPESAFE_API_KEY=

# ─── Jira integration (optional) ──────────────────────────────────────────────
# Personal access token or API token for your Jira instance
JIRA_TOKEN=
# Base URL of your Jira instance, e.g. https://yourorg.atlassian.net
JIRA_BASE_URL=

# ─── Linear integration (optional) ────────────────────────────────────────────
# Off unless true: without it, the Linear endpoints and the webhook return 409
# and nothing is read from or written to Linear, even when a token is set.
LINEAR_ENABLED=false
# Personal API key from Linear settings → API → Personal API keys
LINEAR_TOKEN=
# Secret from the Linear webhook settings page (Settings → API → Webhooks → secret)
LINEAR_WEBHOOK_SECRET=
# Label name that triggers automatic assessment when added to an issue (default: ready-check)
LINEAR_TRIGGER_LABEL=ready-check
# Development only: directory to save verified webhook deliveries to (for test fixtures)
LINEAR_WEBHOOK_CAPTURE_DIR=

# ─── Stored stories (optional) ────────────────────────────────────────────────
# SQLite file for pasted stories and their assessment history (default: data/stories.db)
STORIES_DB_PATH=data/stories.db
